# Production runtime variables.
# Replace every placeholder before deploying.

# External S3-compatible object storage / deployed MinIO
URBAN_LENS_S3_ENDPOINT_URL=https://minio.example.com
URBAN_LENS_S3_ACCESS_KEY=change-me
URBAN_LENS_S3_SECRET_KEY=change-me
URBAN_LENS_S3_BUCKET=urban-lens-prod
URBAN_LENS_S3_REGION=us-east-1
URBAN_LENS_S3_SECURE=true

# External PostgreSQL
URBAN_LENS_POSTGRES_DSN=postgresql://urban_lens:change-me@postgres.example.com:5432/urban_lens

# Runtime settings
URBAN_LENS_ARTIFACT_DIR=/app/.artifacts
MLFLOW_TRACKING_URI=https://mlflow.example.com
MLFLOW_HOST_PORT=5005
RAG_API_HOST_PORT=8000

MILVUS_GRPC_PORT=19530
MILVUS_REST_PORT=9091
URBAN_LENS_MILVUS_URI=http://localhost:19530

OLLAMA_HOST_PORT=11434
URBAN_LENS_OLLAMA_BASE_URL=http://localhost:11434
URBAN_LENS_EMBEDDING_MODEL=nomic-embed-text