# URL do backend FastAPI (server-side only — não expor ao cliente)
BACKEND_URL=http://localhost:8000

# API Key para autenticação no backend (server-side only)
# Gerada via URBAN_LENS_INTERNAL_API_KEY no backend
BACKEND_API_KEY=your-api-key-here

# (Opcional) Override da URL da API para o cliente Next.js
# Padrão: /api/v1 (proxy interno do Next.js)
# NEXT_PUBLIC_API_URL=/api/v1
